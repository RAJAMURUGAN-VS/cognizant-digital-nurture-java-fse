<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:aop="http://www.springframework.org/schema/aop"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/aop
           http://www.springframework.org/schema/aop/spring-aop.xsd">

    <!--
    ============================================================
    Exercise 1 & 5: Basic bean definitions
    ============================================================
    -->

    <!-- BookRepository bean (no dependencies) -->
    <bean id="bookRepository" class="com.library.repository.BookRepository" />

    <!--
    ============================================================
    Exercise 2 & 5: Setter Injection — wire BookRepository into BookService
    ============================================================
    -->

    <!--
    Exercise 7: Constructor Injection variant
    Uncomment the constructor-arg block and comment the property block
    to switch between constructor and setter injection.

    Constructor injection:
    <bean id="bookService" class="com.library.service.BookService">
        <constructor-arg ref="bookRepository" />
    </bean>
    -->

    <!-- Setter Injection (Exercise 2, 5, 7) -->
    <bean id="bookService" class="com.library.service.BookService">
        <!-- Exercise 2 & 5: Setter injection of BookRepository -->
        <property name="bookRepository" ref="bookRepository" />
    </bean>

    <!--
    ============================================================
    Exercise 6: Enable Component Scanning for annotation-based config
    ============================================================
    Scans com.library package for @Service, @Repository, @Component, etc.
    -->
    <context:component-scan base-package="com.library" />

    <!--
    ============================================================
    Exercise 3 & 8: Enable AspectJ auto-proxying + register LoggingAspect
    ============================================================
    -->
    <aop:aspectj-autoproxy />

    <!-- LoggingAspect bean (Exercise 3 & 8) -->
    <bean id="loggingAspect" class="com.library.aspect.LoggingAspect" />

</beans>
